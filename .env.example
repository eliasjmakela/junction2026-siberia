# Copy to .env (git-ignored) to enable the AI features.
# Without keys, application questions and scores use fixed rules and writing help shows demo suggestions.
ANTHROPIC_API_KEY=
# Optional model override for application questions and scoring. Default: claude-opus-5-5
PLAINLY_AI_MODEL=

# Company form writing help. Without a key, fixed demo suggestions are shown.
GEMINI_API_KEY=
# Optional model override. Default: gemini-3.8-flash
PLAINLY_WRITING_MODEL=
